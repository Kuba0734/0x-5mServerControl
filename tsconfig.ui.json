{
  "compilerOptions": {
    "target": "ES2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist/web",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/ui/**/*.ts", "src/shared/**/*.ts"]
}
